<mxfile host="app.diagrams.net" type="device"><diagram id="f1" name="图1 五层总览"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1-c1" value="&lt;b style=&quot;font-size:20px&quot;&gt;图 1 · 五层总览主流程（一页全景）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6c757d&quot; style=&quot;font-size:12px&quot;&gt;蛇形主流程：L1/L2 左→右，L3 右→左，L4 左→右，L5 闭环；右侧为横切带；虚线为回流&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="0" y="-80" width="1200" height="56" as="geometry"/></mxCell><mxCell id="f1-c2" value="L1 数据源与接入" style="swimlane;horizontal=0;startSize=120;html=1;fontSize=14;fontStyle=1;fillColor=#e7f1ff;strokeColor=#4a7bd0;swimlaneFillColor=#e7f1ff66;fontFamily=Microsoft YaHei;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1860" height="200" as="geometry"/></mxCell><mxCell id="f1-c3" value="L2 缺陷发现分级" style="swimlane;horizontal=0;startSize=120;html=1;fontSize=14;fontStyle=1;fillColor=#eef8ee;strokeColor=#3f9142;swimlaneFillColor=#eef8ee66;fontFamily=Microsoft YaHei;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="1860" height="320" as="geometry"/></mxCell><mxCell id="f1-c4" value="L3 云端飞轮" style="swimlane;horizontal=0;startSize=120;html=1;fontSize=14;fontStyle=1;fillColor=#f3edff;strokeColor=#7a52c7;swimlaneFillColor=#f3edff66;fontFamily=Microsoft YaHei;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="520" width="1860" height="260" as="geometry"/></mxCell><mxCell id="f1-c5" value="L4 训练发布" style="swimlane;horizontal=0;startSize=120;html=1;fontSize=14;fontStyle=1;fillColor=#fff3e6;strokeColor=#d9822b;swimlaneFillColor=#fff3e666;fontFamily=Microsoft YaHei;collapsible=0;" vertex="1" parent="1"><mxGeometry x="0" y="780" width="1860" height="200" as="geometry"/></mxCell><mxCell id="f1-c6" value="L5 设备与监